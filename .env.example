# Stripe Payment Links — chappieworks.com
# See BRIEF_STRIPE_SETUP.md for how to create these in the Stripe dashboard.
#
# Both should be subscriptions with a 7-day free trial, collect email, and
# redirect on success to https://chappieworks.com/brief/thanks

# The Brief — Email tier, $29/month
NEXT_PUBLIC_STRIPE_LINK_BRIEF_EMAIL=

# The Brief — Email + Slack/Discord tier, $59/month
NEXT_PUBLIC_STRIPE_LINK_BRIEF_PLUS=

# Brief generator pipeline (server-only). Cron fires daily at 11:00 UTC (5am MDT).
# See BRIEF_STRIPE_SETUP.md for full setup instructions.
#
# Required to generate briefs:
ANTHROPIC_API_KEY=
# Required to pull active subscriber emails from Stripe:
STRIPE_SECRET_KEY=
# Optional — filter to only Brief subscribers by product ID (recommended once live):
STRIPE_PRODUCT_ID_BRIEF=
# Required to protect the cron endpoint — set in Vercel, auto-injected by Vercel Cron:
CRON_SECRET=

# Intake form notifications (server-only — do NOT prefix with NEXT_PUBLIC_).
# See INTAKE_SETUP.md. If RESEND_API_KEY is unset, intake submissions are still
# captured to Vercel server logs but no email notification is sent.
#
# Get a free Resend key at https://resend.com (100/day, 3000/month free).
RESEND_API_KEY=
# Where to send intake notifications (Rob's working inbox).
INTAKE_NOTIFY_EMAIL=
# Verified sender on the Resend domain. Default is intake@chappieworks.com.
INTAKE_FROM_EMAIL=intake@chappieworks.com

# Bypass checkout — if a buyer submits this exact email at any paid SKU,
# the server skips Stripe and ships the unwatermarked product directly to
# their inbox. Internal use only (collect example assets without charging).
# Compared case-insensitively after trim. Leave blank to disable bypass.
BYPASS_CHECKOUT_EMAIL=
